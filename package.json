{
  "name": "dsh-worktree-tree",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness sidebar plugin: group Sessions by Git worktree under each Workspace.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adrien-LD/dsh-worktree-tree.git"
  },
  "homepage": "https://github.com/adrien-LD/dsh-worktree-tree#readme",
  "bugs": {
    "url": "https://github.com/adrien-LD/dsh-worktree-tree/issues"
  }
}
